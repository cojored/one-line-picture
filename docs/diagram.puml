@startuml
title One Line Picture

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho


package "Domain" {
    class GameSessionId <<Value Object>> {
        - UUID value
        + GameSessionId(UUID value)
        + value() UUID 
        + equals(Other other) boolean
        + toString() String
    }

    class PlayerId <<Value Object>> {
        - UUID value
        + PlayerId(UUID value)
        + value () UUID
        + equals(Object other) boolean
        + toString() String
    }

    class StrokeId <<Value Object>> {
        - UUID value
        + StrokeId(UUID value)
        + value() UUID
        + equals(Object other) boolean
        + toString() String
    }

    class ConnectionId <<Value Object>> {
        - UUID value
        + ConnectionId(UUID value)
        + value() UUID
    }

    class CanvasPoint <<Value Object>> {
        - double x
        - double y
        + CanvasPoint(double x, double y)
        + x() double
        + y() double
        + equals(Object other) boolean
        + hashCode() int
    }

    class GameRules <<Value Object>> {
        - int maximumPlayers
        - int minimumPlayers
        - int totalTurns
        - Duration turnDuration
        - double canvasWidth
        - double canvasHeight
        + GameRules(
            int maximumPlayers,
            int minimumPlayers,
            int totalTurns,
            Duration turnDuration,
            double canvasWidth,
            double canvasHeight
          )
        + maximumPlayers() int
        + minimumPlayers() int
        + totalTurns() int
        + turnDuration() Duration
        + canvasWidth() double
        + canvasHeight() double
        + contains(CanvasPoint point) boolean
    }
    note right of GameRules : turnDuration is part of a stretch goal 

    enum GameStatus {
        LOBBY
        IN_PROGRESS
        FINISHED
    }

    enum StrokeStatus {
        ACTIVE
        COMPLETED
    }

    class Player <<Entity>> {
        - PlayerId id
        - String displayName

        + Player(PlayerId id, String displayName)
        + id() PlayerId
        + displayName() String
        + equals(Object other) boolean
    }

    class Stroke <<Entity>> {
        - StrokeId id
        - PlayerId playerId
        - List<CanvasPoint> points
        - StrokeStatus status

        + Stroke(
            StrokeId id,
            PlayerId playerId,
            CanvasPoint startPoint
          )

        + id() StrokeId
        + playerId() PlayerId
        + points() List<CanvasPoint>
        + status() StrokeStatus

        ~ append(CanvasPoint point) void
        ~ complete() void

        + isCompleted() boolean
    }

     class TurnPolicy {
        + firstPlayer(List<Player> players) PlayerId

        + nextPlayer(
            PlayerId currentPlayer,
            List<Player> players,
            int completedTurns,
            int totalTurns
          ) Optional<PlayerId>

        + isGameComplete(
            int completedTurns,
            int totalTurns
          ) boolean
    }

    class GameSession <<Aggregate Root>> {
        - GameSessionId id
        - GameRules rules
        - List<Player> players
        - List<Stroke> completedStrokes
        - Stroke activeStroke
        - TurnPolicy turnPolicy
        - TurnState turnState
        - GameStatus status
        - List<DomainEvent> domainEvents

        + GameSession(
            GameSessionId id,
            GameRules rules,
            TurnPolicy turnPolicy
          )

        + id() GameSessionId
        + rules() GameRules
        + status() GameStatus
        + players() List<Player>
        + completedStrokes() List<Stroke>
        + activeStroke() Optional<Stroke>
        + activePlayer() Optional<Player>
        + turnState() Optional<TurnState>

        + join(Player player) void

        + start(Instant now) void

        + beginStroke(
            PlayerId playerId,
            CanvasPoint startPoint
          ) void

        + appendStrokePoint(
            PlayerId playerId,
            CanvasPoint point
          ) void

        + finishStroke(
            PlayerId playerId,
            Instant now
          ) void

        + expireTurn(Instant now) void

        + isTurnExpired(Instant now) boolean

        + domainEvents() List<DomainEvent>

        + clearDomainEvents() void

        - requireLobby() void
        - requireInProgress() void
        - requireActivePlayer(PlayerId playerId) void
        - requireNoActiveStroke() void
        - requireActiveStroke() Stroke
        - requirePointInsideCanvas(CanvasPoint point) void
        - advanceTurn(Instant now) void
        - addDomainEvent(DomainEvent event) void
    }

    interface DomainEvent {
        + occurredAt() Instant
        + gameId() GameSessionId
    }

    class PlayerJoined <<Domain Event>> {
        - GameSessionId gameId
        - PlayerId playerId
        - String displayName
        - Instant occurredAt

        + gameId() GameSessionId
        + playerId() PlayerId
        + displayName() String
        + occurredAt() Instant
    }

    class GameStarted <<Domain Event>> {
        - GameSessionId gameId
        - PlayerId activePlayerId
        - Instant occurredAt

        + gameId() GameSessionId
        + activePlayerId() PlayerId
        + occurredAt() Instant
    }

    class StrokeStarted <<Domain Event>> {
        - GameSessionId gameId
        - StrokeId strokeId
        - PlayerId playerId
        - CanvasPoint point
        - Instant occurredAt

        + gameId() GameSessionId
        + strokeId() StrokeId
        + playerId() PlayerId
        + point() CanvasPoint
        + occurredAt() Instant
    }

    class StrokePointAdded <<Domain Event>> {
        - GameSessionId gameId
        - StrokeId strokeId
        - PlayerId playerId
        - CanvasPoint point
        - Instant occurredAt

        + gameId() GameSessionId
        + strokeId() StrokeId
        + playerId() PlayerId
        + point() CanvasPoint
        + occurredAt() Instant
    }

    class StrokeCompleted <<Domain Event>> {
        - GameSessionId gameId
        - StrokeId strokeId
        - PlayerId playerId
        - Instant occurredAt

        + gameId() GameSessionId
        + strokeId() StrokeId
        + playerId() PlayerId
        + occurredAt() Instant
    }

    class TurnChanged <<Domain Event>> {
        - GameSessionId gameId
        - PlayerId activePlayerId
        - int completedTurns
        - Instant occurredAt

        + gameId() GameSessionId
        + activePlayerId() PlayerId
        + completedTurns() int
        + occurredAt() Instant
    }

    class GameCompleted <<Domain Event>> {
        - GameSessionId gameId
        - int totalCompletedTurns
        - Instant occurredAt

        + gameId() GameSessionId
        + totalCompletedTurns() int
        + occurredAt() Instant
    }

    enum GameError {
        GAME_ALREADY_STARTED
        GAME_NOT_STARTED
        GAME_FINISHED
        GAME_FULL
        NOT_ENOUGH_PLAYERS
        PLAYER_ALREADY_JOINED
        PLAYER_NOT_FOUND
        NOT_ACTIVE_PLAYER
        STROKE_ALREADY_ACTIVE
        NO_ACTIVE_STROKE
        POINT_OUT_OF_BOUNDS
        INVALID_GAME_RULES
        INVALID_PLAYER_NAME
    }

    class DomainException {
        - GameError error
        - String message

        + DomainException(GameError error, String message)
        + error() GameError
        + getMessage() String
    }

    interface GameSessionFactory {
        + create(GameRules rules) GameSession
    }

    class DefaultGameSessionFactory {
        - TurnPolicyFactory turnPolicyFactory
        - IdGenerator idGenerator

        + DefaultGameSessionFactory(
            TurnPolicyFactory turnPolicyFactory,
            IdGenerator idGenerator
          )

        + create(GameRules rules) GameSession
    }

    interface PlayerFactory {
        + create(String displayName) Player
    }

    class DefaultPlayerFactory {
        - IdGenerator idGenerator

        + DefaultPlayerFactory(IdGenerator idGenerator)
        + create(String displayName) Player
    }

    interface StrokeFactory {
        + create(
            PlayerId playerId,
            CanvasPoint startPoint
          ) Stroke
    }

    class DefaultStrokeFactory {
        - IdGenerator idGenerator

        + DefaultStrokeFactory(IdGenerator idGenerator)

        + create(
            PlayerId playerId,
            CanvasPoint startPoint
          ) Stroke
    }

    interface IdGenerator {
        + next() UUID
    }

    class UuidGenerator {
        + next() UUID
    }

    interface TurnPolicyFactory {
        + create(GameRules rules) TurnPolicy
    }

    class DefaultTurnPolicyFactory {
        + create(GameRules rules) TurnPolicy
    }    interface GameSessionFactory {
        + create(GameRules rules) GameSession
    }

    class DefaultGameSessionFactory {
        - TurnPolicyFactory turnPolicyFactory
        - IdGenerator idGenerator

        + DefaultGameSessionFactory(
            TurnPolicyFactory turnPolicyFactory,
            IdGenerator idGenerator
          )

        + create(GameRules rules) GameSession
    }

    interface PlayerFactory {
        + create(String displayName) Player
    }

    class DefaultPlayerFactory {
        - IdGenerator idGenerator

        + DefaultPlayerFactory(IdGenerator idGenerator)
        + create(String displayName) Player
    }

    interface StrokeFactory {
        + create(
            PlayerId playerId,
            CanvasPoint startPoint
          ) Stroke
    }

    class DefaultStrokeFactory {
        - IdGenerator idGenerator

        + DefaultStrokeFactory(IdGenerator idGenerator)

        + create(
            PlayerId playerId,
            CanvasPoint startPoint
          ) Stroke
    }

    interface IdGenerator {
        + next() UUID
    }

    class UuidGenerator {
        + next() UUID
    }

    interface TurnPolicyFactory {
        + create(GameRules rules) TurnPolicy
    }

    class DefaultTurnPolicyFactory {
        + create(GameRules rules) TurnPolicy
    }

    class GameRulesBuilder <<Builder>> {
        - int maximumPlayers
        - int minimumPlayers
        - int totalTurns
        - Duration turnDuration
        - double canvasWidth
        - double canvasHeight

        + create() GameRulesBuilder

        + maximumPlayers(int value) GameRulesBuilder
        + minimumPlayers(int value) GameRulesBuilder
        + totalTurns(int value) GameRulesBuilder
        + turnDuration(Duration value) GameRulesBuilder

        + canvasSize(
            double width,
            double height
          ) GameRulesBuilder

        + build() GameRules
    }

    GameSession "1" *-- "1" GameSessionId
    GameSession "1" *-- "1" GameRules
    GameSession "1" *-- "0..*" Player
    GameSession "1" *-- "0..*" Stroke
    GameSession "1" o-- "0..1" Stroke : activeStroke
    GameSession "1" o-- "0..1" TurnState
    GameSession --> GameStatus
    GameSession --> TurnPolicy
    GameSession --> DomainEvent
    GameSession ..> DomainException

    Player "1" *-- "1" PlayerId

    Stroke "1" *-- "1" StrokeId
    Stroke "1" --> "1" PlayerId
    Stroke "1" *-- "1..*" CanvasPoint
    Stroke --> StrokeStatus

    TurnState --> PlayerId


    DomainEvent <|.. PlayerJoined
    DomainEvent <|.. GameStarted
    DomainEvent <|.. StrokeStarted
    DomainEvent <|.. StrokePointAdded
    DomainEvent <|.. StrokeCompleted
    DomainEvent <|.. TurnChanged
    DomainEvent <|.. GameCompleted

    GameSessionFactory <|.. DefaultGameSessionFactory
    PlayerFactory <|.. DefaultPlayerFactory
    StrokeFactory <|.. DefaultStrokeFactory
    IdGenerator <|.. UuidGenerator
    TurnPolicyFactory <|.. DefaultTurnPolicyFactory

    DefaultGameSessionFactory --> IdGenerator
    DefaultGameSessionFactory --> TurnPolicyFactory
    DefaultGameSessionFactory --> GameSession

    DefaultPlayerFactory --> IdGenerator
    DefaultPlayerFactory --> Player

    DefaultStrokeFactory --> IdGenerator
    DefaultStrokeFactory --> Stroke

    DefaultTurnPolicyFactory --> TurnPolicy

    GameRulesBuilder --> GameRules
}


package "Application" {
    interface GameCommand {
        + gameId() GameSessionId
    }

    class JoinGameCommand <<Command>> {
        - GameSessionId gameId
        - String displayName

        + gameId() GameSessionId
        + displayName() String
    }

    class StartGameCommand <<Command>> {
        - GameSessionId gameId
        - PlayerId requestingPlayerId

        + gameId() GameSessionId
        + requestingPlayerId() PlayerId
    }

    class BeginStrokeCommand <<Command>> {
        - GameSessionId gameId
        - PlayerId playerId
        - CanvasPoint point

        + gameId() GameSessionId
        + playerId() PlayerId
        + point() CanvasPoint
    }

    class AppendStrokePointCommand <<Command>> {
        - GameSessionId gameId
        - PlayerId playerId
        - CanvasPoint point

        + gameId() GameSessionId
        + playerId() PlayerId
        + point() CanvasPoint
    }

    class FinishStrokeCommand <<Command>> {
        - GameSessionId gameId
        - PlayerId playerId

        + gameId() GameSessionId
        + playerId() PlayerId
    }

    class ExpireTurnCommand <<Command>> {
        - GameSessionId gameId

        + gameId() GameSessionId
    }

    class CommandResult<T> {
        - boolean successful
        - T value
        - GameError error
        - String message

        + success(T value) CommandResult<T>
        + failure(GameError error, String message) CommandResult<T>

        + successful() boolean
        + value() Optional<T>
        + error() Optional<GameError>
        + message() String
    }

    interface CommandHandler<C extends GameCommand> {
        + handle(C command) CommandResult<?>
    }

    class JoinGameHandler {
        - GameSessionRepository repository
        - PlayerFactory playerFactory
        - DomainEventPublisher eventPublisher

        + JoinGameHandler(
            GameSessionRepository repository,
            PlayerFactory playerFactory,
            DomainEventPublisher eventPublisher
          )

        + handle(
            JoinGameCommand command
          ) CommandResult<PlayerId>
    }

    class StartGameHandler {
        - GameSessionRepository repository
        - DomainEventPublisher eventPublisher
        - Clock clock

        + handle(
            StartGameCommand command
          ) CommandResult<Void>
    }

    class BeginStrokeHandler {
        - GameSessionRepository repository
        - DomainEventPublisher eventPublisher

        + handle(
            BeginStrokeCommand command
          ) CommandResult<Void>
    }

    class AppendStrokePointHandler {
        - GameSessionRepository repository
        - DomainEventPublisher eventPublisher

        + handle(
            AppendStrokePointCommand command
          ) CommandResult<Void>
    }

    class FinishStrokeHandler {
        - GameSessionRepository repository
        - DomainEventPublisher eventPublisher
        - Clock clock

        + handle(
            FinishStrokeCommand command
          ) CommandResult<Void>
    }

    class ExpireTurnHandler {
        - GameSessionRepository repository
        - DomainEventPublisher eventPublisher
        - Clock clock

        + handle(
            ExpireTurnCommand command
          ) CommandResult<Void>
    }

    interface CommandDispatcher {
        + dispatch(GameCommand command) CommandResult<?>
    }

    class DefaultCommandDispatcher {
        - Map<Class<?>, CommandHandler<?>> handlers

        + register(
            Class<?> commandType,
            CommandHandler<?> handler
          ) void

        + dispatch(
            GameCommand command
          ) CommandResult<?>
    }

    interface GameSessionRepository {
        + findById(
            GameSessionId id
          ) Optional<GameSession>

        + save(
            GameSession session
          ) void

        + remove(
            GameSessionId id
          ) void

        + exists(
            GameSessionId id
          ) boolean
    }

    interface DomainEventPublisher {
        + publish(
            Collection<DomainEvent> events
          ) void
    }

        class GetGameStateQuery {
        - GameSessionId gameId
        + gameId() GameSessionId
    }

    class GetReplayQuery {
        - GameSessionId gameId
        + gameId() GameSessionId
    }

    interface GameStateQueryService {
        + getState(
            GetGameStateQuery query
          ) GameStateDto
    }

    class GameStateDto <<DTO>> {
        - String gameId
        - GameStatus status
        - List<PlayerDto> players
        - List<StrokeDto> strokes
        - String activePlayerId
        - int completedTurns
        - GameRulesDto rules

        + gameId() String
        + status() GameStatus
        + players() List<PlayerDto>
        + strokes() List<StrokeDto>
        + activePlayerId() String
        + completedTurns() int
        + rules() GameRulesDto
    }

    class PlayerDto <<DTO>> {
        - String id
        - String displayName

        + id() String
        + displayName() String
    }

    class StrokeDto <<DTO>> {
        - String id
        - String playerId
        - List<CanvasPointDto> points

        + id() String
        + playerId() String
        + points() List<CanvasPointDto>
    }

    class CanvasPointDto <<DTO>> {
        - double x
        - double y
        + x() double
        + y() double
    }

    class GameRulesDto <<DTO>> {
        - int maximumPlayers
        - int totalTurns
        - long turnDurationMs
        - double canvasWidth
        - double canvasHeight
    }

    interface GameStateMapper {
        + toDto(GameSession session) GameStateDto
    }

    class DefaultGameStateMapper {
        + toDto(GameSession session) GameStateDto
    }

        interface ReplayService {
        + createReplay(
            GameSessionId gameId
          ) Replay
    }

    class DefaultReplayService {
        - GameSessionRepository repository

        + DefaultReplayService(
            GameSessionRepository repository
          )

        + createReplay(
            GameSessionId gameId
          ) Replay
    }

    class Replay {
        - List<ReplayFrame> frames
        - Duration totalDuration

        + frames() List<ReplayFrame>
        + totalDuration() Duration
    }

    class ReplayFrame {
        - StrokeId strokeId
        - PlayerId playerId
        - CanvasPoint point
        - Duration offset

        + strokeId() StrokeId
        + playerId() PlayerId
        + point() CanvasPoint
        + offset() Duration
    }

        interface ServerGateway {
        + connect(String host, int port) void
        + disconnect() void
        + send(ClientMessage message) void
        + isConnected() boolean
    }

    class ClientGameService {
        - ServerGateway serverGateway
        - ClientGameState state
        - ClientMessageFactory messageFactory

        + ClientGameService(
            ServerGateway serverGateway,
            ClientGameState state,
            ClientMessageFactory messageFactory
          )

        + connect(
            String host,
            int port
          ) void

        + disconnect() void

        + requestJoin(
            String displayName
          ) void

        + requestGameStart() void

        + requestStrokeStart(
            CanvasPoint point
          ) void

        + sendStrokePoint(
            CanvasPoint point
          ) void

        + requestStrokeEnd() void

        + apply(
            ServerMessage message
          ) void

        + state() ClientGameState
    }

        GameCommand <|.. JoinGameCommand
    GameCommand <|.. StartGameCommand
    GameCommand <|.. BeginStrokeCommand
    GameCommand <|.. AppendStrokePointCommand
    GameCommand <|.. FinishStrokeCommand
    GameCommand <|.. ExpireTurnCommand

    CommandHandler <|.. JoinGameHandler
    CommandHandler <|.. StartGameHandler
    CommandHandler <|.. BeginStrokeHandler
    CommandHandler <|.. AppendStrokePointHandler
    CommandHandler <|.. FinishStrokeHandler
    CommandHandler <|.. ExpireTurnHandler

    CommandDispatcher <|.. DefaultCommandDispatcher

    JoinGameHandler --> GameSessionRepository
    JoinGameHandler --> PlayerFactory
    JoinGameHandler --> DomainEventPublisher

    StartGameHandler --> GameSessionRepository
    StartGameHandler --> DomainEventPublisher

    BeginStrokeHandler --> GameSessionRepository
    BeginStrokeHandler --> DomainEventPublisher

    AppendStrokePointHandler --> GameSessionRepository
    AppendStrokePointHandler --> DomainEventPublisher

    FinishStrokeHandler --> GameSessionRepository
    FinishStrokeHandler --> DomainEventPublisher

    ExpireTurnHandler --> GameSessionRepository
    ExpireTurnHandler --> DomainEventPublisher

    DefaultCommandDispatcher --> CommandHandler

    GameStateQueryService --> GameSessionRepository
    GameStateMapper <|.. DefaultGameStateMapper
    DefaultGameStateMapper --> GameSession

    ReplayService <|.. DefaultReplayService
    DefaultReplayService --> GameSessionRepository

    Replay "1" *-- "0..*" ReplayFrame

    ClientGameService --> ServerGateway
}

package "Client State" {
        class ClientGameState {
        - GameSessionId gameId
        - GameStatus status
        - Map<PlayerId, ClientPlayerState> players
        - List<ClientStrokeState> strokes
        - PlayerId activePlayerId
        - int completedTurns
        - GameRulesDto rules

        + apply(ServerMessage message) void

        + gameId() GameSessionId
        + status() GameStatus
        + players() Collection<ClientPlayerState>
        + strokes() List<ClientStrokeState>
        + activePlayerId() Optional<PlayerId>
        + completedTurns() int
        + rules() GameRulesDto

        + isLocalPlayersTurn(
            PlayerId localPlayerId
          ) boolean
    }

    class ClientPlayerState {
        - PlayerId id
        - String displayName

        + id() PlayerId
        + displayName() String
    }

    class ClientStrokeState {
        - StrokeId id
        - PlayerId playerId
        - List<CanvasPoint> points
        - boolean completed

        + id() StrokeId
        + playerId() PlayerId
        + points() List<CanvasPoint>
        + completed() boolean

        + append(CanvasPoint point) void
        + complete() void
    }

    ClientGameState "1" *-- "*" ClientPlayerState
    ClientGameState "1" *-- "*" ClientStrokeState
}

